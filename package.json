{
  "name": "dsh-memory-dream",
  "version": "0.2.0",
  "description": "Layered agent memory for DeepSeek Harness: a hard-capped MEMORY.md index injected every turn, dated notes, topic wikis, and a dream pass that verifies memory against real conversation transcripts and records what it cannot resolve.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.ja.md",
    "docs/architecture.svg"
  ],
  "scripts": {
    "test": "node test/setup.mjs && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "dreaming",
    "memory-consolidation"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
