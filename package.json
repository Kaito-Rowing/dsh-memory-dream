{
  "name": "dsh-memory-dream",
  "version": "0.3.0",
  "description": "Layered agent memory for DeepSeek Harness: a hard-capped MEMORY.md index injected every turn, dated notes, topic wikis, a dream pass that verifies memory against real conversation transcripts, and optional local telemetry for debugging it.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "README.ja.md",
    "docs/"
  ],
  "scripts": {
    "test": "node test/setup.mjs && node --test test/units.test.mjs test/integration.test.mjs test/cordis.test.mjs test/telemetry.test.mjs test/observability.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "dreaming",
    "memory-consolidation"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Kaito-Rowing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaito-Rowing/dsh-memory-dream.git"
  },
  "homepage": "https://github.com/Kaito-Rowing/dsh-memory-dream#readme",
  "bugs": {
    "url": "https://github.com/Kaito-Rowing/dsh-memory-dream/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
